    {"id": "fam-2-r02", "item": "fam-oniisan", "prompt": "講朋友的哥哥，用哪個說法？"}
   ],
   "apply": {"id": "fam-2-a01", "ex": "ex-fam-5", "prompt": "對老師說：「我哥哥是大學生。」"}
