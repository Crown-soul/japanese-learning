    {"id": "fam-2-q05", "type": "choice", "err": "reading", "item": "fam-ani", "prompt": "「兄」怎麼念？", "options": ["あに", "あね", "にい"], "answer": 0, "why": "兄＝あに、姉＝あね。"},
    {"id": "fam-2-q06", "type": "choice", "err": "reading", "item": "fam-ane", "prompt": "「姉」怎麼念？", "options": ["あね", "あに", "ねえ"], "answer": 0, "why": "姉＝あね。"},
    {"id": "fam-2-q07", "type": "listen", "err": "reading", "item": "fam-oniisan", "options": ["お兄さん", "お姉さん", "兄"], "answer": 0},
    {"id": "fam-2-q08", "type": "listen", "err": "reading", "item": "fam-ane", "options": ["姉", "兄", "お姉さん"], "answer": 0}
   ],
   "recall": [
