    {"id": "fam-3-q02", "type": "choice", "err": "context", "item": "fam-oniichan", "scene": ["我", "我的哥哥（直接叫）", "—"], "prompt": "＿＿、ちょっと来て。", "options": ["兄", "お兄ちゃん"], "answer": 1, "why": "直接叫哥哥 → お兄ちゃん（或 お兄さん）。"},
    {"id": "fam-3-q03", "type": "choice", "err": "context", "item": "fam-otousan", "scene": ["我", "剛回家的爸爸（直接叫）", "—"], "prompt": "＿＿、おかえりなさい。", "options": ["父", "お父さん"], "answer": 1, "why": "直接叫爸爸 → お父さん。"},
    {"id": "fam-3-q04", "type": "choice", "err": "context", "item": "fam-oneechan", "scene": ["我", "我的姊姊（直接叫）", "—"], "prompt": "＿＿、これ見て！", "options": ["姉", "お姉ちゃん"], "answer": 1, "why": "直接叫姊姊 → お姉ちゃん（或 お姉さん）。"},
