 "sections": {
  "hai-1": {
   "title": "杯：一杯〜五杯",
   "goal": "在店裡能說「一杯、兩杯、三杯…」，不把 さんばい 念成 さんはい。",
   "use": "「杯」數的是裝在杯子、碗裡的飲料或食物：咖啡、水、茶、酒、白飯、湯。數的是「幾杯／幾碗」，不是瓶子（瓶子用「本」，之後的小節教）。",
   "items": ["hai-1", "hai-2", "hai-3", "hai-4", "hai-5"],
   "examples": ["ex-hai-1", "ex-hai-2", "ex-hai-3"],
   "compare": {"title": "看出變化", "items": ["hai-1", "hai-2", "hai-3", "hai-4", "hai-5"]},
   "rules": [
    "1 → <b>いっぱい</b>：數字變促音「っ」，はい 變 <b>ぱい</b>。",
    "3 → <b>さんばい</b>：はい 變 <b>ばい</b>。",
    "2・4・5 不變：にはい、よんはい、ごはい。",
    "這是「杯」的規則。は→ぱ／ば 只發生在 は 行開頭的量詞（杯、本、匹）；冊、枚 就不會這樣變（三冊＝さんさつ）。",
    "小知識：いっぱい 也是「滿滿的、很多」的意思（お腹がいっぱい＝吃飽了）。"
   ],
   "quiz": [
    {"id": "hai-1-q01", "type": "choice", "err": "reading", "item": "hai-1", "prompt": "「一杯」怎麼念？", "options": ["いっぱい", "いちはい", "いっはい"], "answer": 0, "why": "1 變促音，は 變 ぱ。"},
    {"id": "hai-1-q02", "type": "choice", "err": "reading", "item": "hai-3", "prompt": "「三杯」怎麼念？", "options": ["さんはい", "さんばい", "さんぱい"], "answer": 1, "why": "3 後面的 は 變 ば。"},
    {"id": "hai-1-q03", "type": "choice", "err": "reading", "item": "hai-4", "prompt": "「四杯」怎麼念？", "options": ["よんはい", "よんぱい", "しはい"], "answer": 0, "why": "4 不變音；4 念 よん，不念 し。"},
    {"id": "hai-1-q04", "type": "choice", "err": "counter", "prompt": "下面哪一個用「杯」來數？", "options": ["コーヒー（咖啡）", "本（書）", "猫（貓）"], "answer": 0, "why": "杯 數杯子、碗裡的飲料或食物。"},
    {"id": "hai-1-q05", "type": "choice", "err": "reading", "item": "hai-5", "prompt": "「ごはい」是幾杯？", "options": ["五杯", "四杯", "九杯"], "answer": 0, "why": "ご＝5。"},
    {"id": "hai-1-q06", "type": "listen", "err": "reading", "item": "hai-3", "options": ["一杯", "三杯", "四杯"], "answer": 1},
    {"id": "hai-1-q07", "type": "listen", "err": "reading", "item": "hai-1", "options": ["一杯", "二杯", "五杯"], "answer": 0},
    {"id": "hai-1-q08", "type": "listen", "err": "reading", "item": "hai-2", "options": ["二杯", "四杯", "五杯"], "answer": 0}
   ],
   "recall": [
    {"id": "hai-1-r01", "item": "hai-5", "prompt": "「五杯」自己念念看"},
    {"id": "hai-1-r02", "item": "hai-3", "prompt": "「三杯」自己念念看"},
    {"id": "hai-1-r03", "item": "hai-1", "prompt": "「一杯」自己念念看"}
   ],
   "apply": {"id": "hai-1-a01", "ex": "ex-hai-1", "prompt": "在咖啡店，要點一杯咖啡。怎麼說？"}
  },
  "hai-2": {
   "title": "杯：六杯〜十杯、何杯",
   "goal": "說出 6–10 杯，會問「幾杯？」（なんばい）。",
   "use": "跟上一節一樣，杯 數杯子、碗裡的東西。這節把 6–10 和「幾杯」補齊。",
   "items": ["hai-6", "hai-7", "hai-8", "hai-9", "hai-10", "hai-q"],
   "examples": ["ex-hai-4", "ex-hai-5", "ex-hai-6"],
   "compare": {"title": "1–10 全部排在一起", "items": ["hai-1", "hai-2", "hai-3", "hai-4", "hai-5", "hai-6", "hai-7", "hai-8", "hai-9", "hai-10", "hai-q"]},
   "rules": [
    "6・8・10 跟 1 一樣：促音＋<b>ぱい</b>（ろっぱい、はっぱい、じゅっぱい）。",
    "「何」跟 3 一樣：<b>ばい</b>（なんばい）。",
    "7・9 不變：ななはい、きゅうはい。",
    "8 也可以說 はちはい，10 也可以說 じっぱい，兩種都對；這裡主教 はっぱい、じゅっぱい。"
   ],
   "quiz": [
    {"id": "hai-2-q01", "type": "choice", "err": "reading", "item": "hai-6", "prompt": "「六杯」怎麼念？", "options": ["ろっぱい", "ろくはい", "ろくぱい"], "answer": 0, "why": "6 變促音，は 變 ぱ。"},
    {"id": "hai-2-q02", "type": "choice", "err": "reading", "item": "hai-8", "prompt": "「八杯」怎麼念？", "options": ["はちぱい", "はっぱい", "はっはい"], "answer": 1, "why": "8 變促音＋ぱい；はちはい 也對，但不在選項裡。"},
    {"id": "hai-2-q03", "type": "choice", "err": "reading", "item": "hai-10", "prompt": "「十杯」怎麼念？", "options": ["じゅうはい", "じゅっぱい", "じゅうばい"], "answer": 1, "why": "10 變促音＋ぱい（也可說 じっぱい）。"},
    {"id": "hai-2-q04", "type": "choice", "err": "reading", "item": "hai-q", "prompt": "「何杯」（幾杯）怎麼念？", "options": ["なんはい", "なんぱい", "なんばい"], "answer": 2, "why": "何 跟 3 一樣變 ば。"},
    {"id": "hai-2-q05", "type": "choice", "err": "reading", "item": "hai-7", "prompt": "「七杯」怎麼念？", "options": ["ななはい", "ななぱい", "ななばい"], "answer": 0, "why": "7 不變音。"},
    {"id": "hai-2-q06", "type": "listen", "err": "reading", "item": "hai-9", "options": ["九杯", "七杯", "十杯"], "answer": 0},
    {"id": "hai-2-q07", "type": "listen", "err": "reading", "item": "hai-6", "options": ["六杯", "八杯", "十杯"], "answer": 0},
    {"id": "hai-2-q08", "type": "choice", "err": "reading", "item": "hai-q", "prompt": "哪一個跟「三杯」一樣念成「〜ばい」？", "options": ["何杯", "六杯", "二杯"], "answer": 0, "why": "何杯＝なんばい；六杯＝ろっぱい、二杯＝にはい。"}
   ],
   "recall": [
    {"id": "hai-2-r01", "item": "hai-8", "prompt": "「八杯」自己念念看"},
    {"id": "hai-2-r02", "item": "hai-10", "prompt": "「十杯」自己念念看"},
    {"id": "hai-2-r03", "item": "hai-q", "prompt": "「何杯」自己念念看"}
   ],
   "apply": {"id": "hai-2-a01", "ex": "ex-hai-7", "prompt": "朋友說他喝了很多咖啡。問他「你喝了幾杯？」"}
  },
  "fam-1": {
   "title": "爸爸、媽媽：自己的 vs 別人的",
   "goal": "對老師、同事講自己的爸媽用 父・母；講別人的爸媽用 お父さん・お母さん。",
   "use": "日文講家人要看「在跟誰說、講的是誰的家人」。對外人講自己家要謙虛（不加 お〜さん）；講別人家要尊敬（加 お〜さん）。",
   "items": ["fam-chichi", "fam-haha", "fam-otousan", "fam-okaasan"],
   "examples": ["ex-fam-1", "ex-fam-2", "ex-fam-3", "ex-fam-4"],
   "compare": {"title": "同一個人，兩種說法", "family": [["fam-chichi", "fam-otousan"], ["fam-haha", "fam-okaasan"]]},
   "rules": [
    "對<b>外人</b>（老師、同事、面試官、剛認識的人）講<b>自己的</b>爸媽：<b>父</b>（ちち）、<b>母</b>（はは）。",
    "講<b>別人的</b>爸媽：<b>お父さん</b>、<b>お母さん</b>。",
    "跟好朋友聊天時，日本人也常說「うちのお母さん」，不算錯但比較隨便；正式場合一定用 母。",
    "在家裡跟家人說話，或直接叫爸媽，用 お父さん・お母さん（第 3 節會練）。"
   ],
   "quiz": [
    {"id": "fam-1-q01", "type": "choice", "err": "context", "item": "fam-haha", "scene": ["我", "老師", "我的媽媽"], "prompt": "＿＿は料理が上手です。", "options": ["母", "お母さん"], "answer": 0, "why": "對老師講自己的媽媽 → 母。"},
    {"id": "fam-1-q02", "type": "choice", "err": "context", "item": "fam-otousan", "scene": ["我", "田中同學", "田中的爸爸"], "prompt": "田中さんの＿＿は先生ですか。", "options": ["父", "お父さん"], "answer": 1, "why": "講別人的爸爸 → お父さん。"},
    {"id": "fam-1-q03", "type": "choice", "err": "context", "item": "fam-chichi", "scene": ["我", "公司同事", "我的爸爸"], "prompt": "＿＿は会社員です。", "options": ["父", "お父さん"], "answer": 0, "why": "對同事講自己的爸爸 → 父。"},
    {"id": "fam-1-q04", "type": "choice", "err": "context", "item": "fam-okaasan", "scene": ["我", "朋友", "朋友的媽媽"], "prompt": "＿＿はお元気ですか。", "options": ["母", "お母さん"], "answer": 1, "why": "問別人的媽媽 → お母さん。"},
    {"id": "fam-1-q05", "type": "choice", "err": "reading", "item": "fam-chichi", "prompt": "「父」怎麼念？", "options": ["ちち", "はは", "とう"], "answer": 0, "why": "父＝ちち、母＝はは。"},
    {"id": "fam-1-q06", "type": "choice", "err": "reading", "item": "fam-haha", "prompt": "「母」怎麼念？", "options": ["はは", "ちち", "かあ"], "answer": 0, "why": "母＝はは。"},
    {"id": "fam-1-q07", "type": "listen", "err": "reading", "item": "fam-okaasan", "options": ["お母さん", "母", "お父さん"], "answer": 0},
    {"id": "fam-1-q08", "type": "listen", "err": "reading", "item": "fam-chichi", "options": ["父", "母", "お父さん"], "answer": 0}
   ],
   "recall": [
    {"id": "fam-1-r01", "item": "fam-haha", "prompt": "對老師講「我媽媽」，用哪個說法？"},
    {"id": "fam-1-r02", "item": "fam-otousan", "prompt": "問朋友「你爸爸」，用哪個說法？"}
   ],
   "apply": {"id": "fam-1-a01", "ex": "ex-fam-1", "prompt": "面試時介紹：「我爸爸是上班族。」"}
